# OwnerRez API — cabin descriptions pulled from the owner's OwnerRez listings.
# From the owner's OwnerRez OAuth app (Settings > Advanced Tools > Developer/API Settings).
# Leave the token blank to show the built-in descriptions instead.
OWNERREZ_CLIENT_ID=
OWNERREZ_CLIENT_SECRET=
OWNERREZ_ACCESS_TOKEN=
# Basic-auth login set on that app's webhook; lets OwnerRez refresh descriptions instantly.
OWNERREZ_WEBHOOK_USER=
OWNERREZ_WEBHOOK_PASSWORD=

# Resend — delivers contact form messages by email. Leave blank for demo mode (nothing sent).
# CONTACT_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=reservations@vacaytothesmokies.com
CONTACT_FROM_EMAIL=
