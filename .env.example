# OwnerRez API v2 — live availability, pricing and reservations.
# Leave blank to run on the built-in demo calendar and pricing.
# Create a Personal Access Token in OwnerRez: Settings > API & Integrations > Personal Access Tokens.
OWNERREZ_USERNAME=
OWNERREZ_TOKEN=

# Resend — delivers contact form messages by email. Leave blank for demo mode (nothing sent).
# CONTACT_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=reservations@vacaytothesmokies.com
CONTACT_FROM_EMAIL=
